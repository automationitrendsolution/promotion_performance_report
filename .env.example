# ---------------------------------------------------------------------------
# PromoFlow configuration
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored and must never be committed. On EC2, prefer real
# environment variables (systemd EnvironmentFile) or AWS Secrets Manager.
# Exported variables win over .env, so the same checkout works in both places.
# ---------------------------------------------------------------------------

# --- Selling Partner API (Login with Amazon) -------------------------------
# From the app in Seller Central > Develop Apps. The refresh token is issued
# when the seller authorises the app.
#
# No AWS access key, secret key or IAM role ARN is needed: SP-API stopped
# requiring AWS Signature Version 4 in October 2023.
SP_API_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SP_API_CLIENT_SECRET=amzn1.oa2-cs.v1.change-me
SP_API_REFRESH_TOKEN=Atzr|change-me
# Regional endpoint: -na (North America), -eu (Europe), -fe (Far East).
SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
SP_API_TIMEOUT_SECONDS=60

# --- Report ----------------------------------------------------------------
# Comma-separated. ATVPDKIKX0DER = Amazon.com (US).
MARKETPLACE_IDS=ATVPDKIKX0DER
# Default window: promotions that STARTED in the last N days (UTC).
# Override per run with --date-from / --date-to.
PROMOTION_LOOKBACK_DAYS=30
# How often to ask Amazon whether the report is ready, and for how long.
# A run that times out prints the report ID; resume it with --report-id.
REPORT_POLL_INTERVAL_SECONDS=30
REPORT_POLL_TIMEOUT_SECONDS=1800

# --- MySQL -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=powerbidb
DB_USER=powerbi_user
DB_PASSWORD=change-me

# Target table. PromoFlow reflects it at runtime and writes the columns that
# are really there; it never alters an existing table.
DB_TABLE=api_promotion_data
# Rows are replaced per promotion: every row whose key is in the report is
# deleted and re-inserted, in one transaction. Other promotions are untouched.
DB_KEY_COLUMN=promotionId

# Create the table only if it is entirely absent. An existing table is never
# touched.
CREATE_TABLES=false

# TLS. Point DB_SSL_CA at a CA bundle when the server requires one.
# DB_SSL_CA=certs/isrgrootx1.pem
DB_SSL_VERIFY_CERT=false
DB_SSL_DISABLED=false
DB_CONNECT_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# --- Paths (relative paths resolve against the project root) ---------------
DOWNLOAD_DIR=data/downloads
PROCESSED_DIR=data/processed
# Reports that downloaded but could not be loaded. Retry with --process-file.
FAILED_DIR=data/failed
LOG_DIR=logs
LOCK_FILE=data/promoflow.lock

# --- Retry -----------------------------------------------------------------
# Transient failures only (throttling, 5xx, dropped connections).
# Refused credentials are never retried.
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
RETRY_BACKOFF_MAX_SECONDS=120

# --- Logging and housekeeping ----------------------------------------------
LOG_LEVEL=INFO
# cron.log rotates at UTC midnight; rotated files older than this are deleted.
LOG_RETENTION_DAYS=5
# Age at which PromoFlow deletes its OWN downloads and previews. Nothing else.
FILE_RETENTION_DAYS=30
# A report is deleted as soon as its rows are in MySQL. Set true to keep a
# copy in PROCESSED_DIR instead (still pruned after FILE_RETENTION_DAYS).
KEEP_PROCESSED_REPORT=false
